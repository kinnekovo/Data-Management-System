# Windows local development defaults (MongoDB Community Server).
MONGODB_DATABASE=survey_system
MONGODB_TEST_DATABASE=survey_system_test
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_TIMEOUT_MS=5000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret-for-non-local-use
JWT_EXPIRE_MINUTES=120
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional Docker Compose deployment only. These are local-development examples.
MONGO_ROOT_USERNAME=survey_admin
MONGO_ROOT_PASSWORD=local-dev-change-me
MONGO_DATABASE=survey_system
MONGO_HOST_PORT=27018
